{
  "sources": { "github": { "name": "GitHub" } },
  "agents": {
    "watcher": {
      "name": "看新 issue",
      "worker": "mac-mini",
      "use": "command",
      "command": ["{cwd}/examples/watch-github-issues.sh", "owner/repo", "created:>=YYYY-MM-DDT00:00:00+08:00"]
    },
    "agent": { "name": "Agent", "worker": "mac-mini", "use": "codex", "access": "edit" }
  },
  "rules": [
    {
      "name": "看新 issue",
      "when": { "cron": "*/5 * * * *" },
      "to": "watcher",
      "cwd": "~/.agent-autoloop/app",
      "tell": "never",
      "emits": { "source": "github", "types": ["issues.opened"] }
    },
    {
      "name": "处理 issue",
      "when": { "source": "github", "types": ["issues.opened"] },
      "to": "agent",
      "cwd": "~/code/app",
      "skill": "handle-issue",
      "parallel": 1
    }
  ]
}
